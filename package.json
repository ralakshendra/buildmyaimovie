{
  "name": "build-my-ai-movie-cohort",
  "private": true,
  "scripts": {
    "qa:visual": "playwright test -c qa/playwright.config.js",
    "resources:build": "node scripts/build-prompt-vault.cjs && node scripts/build-resources.cjs",
    "build": "node scripts/build-learning-paths.cjs && node scripts/build-prompt-vault.cjs && node scripts/link-prompt-vault.cjs && node scripts/build-resources.cjs && node scripts/build-site.cjs && node scripts/check-site.cjs && node scripts/build-batch-access.cjs",
    "site:check": "node scripts/check-site.cjs",
    "qa:cohesion": "node scripts/audit-site.cjs",
    "session:new": "node scripts/new-session.cjs",
    "qa:release": "node qa/release-boundaries.cjs",
    "qa:review": "node scripts/review-check.cjs",
    "preview": "python scripts/serve-preview.py --port 8766",
    "qa:fixes": "node qa/fixes-check.cjs",
    "qa:content-review": "node qa/final-review.cjs",
    "qa:student": "node qa/student-workflow.cjs",
    "qa:audit": "node qa/audit-fixes.cjs",
    "qa:generated": "node scripts/check-generated.cjs",
    "qa:resource-links": "node qa/resource-links.cjs",
    "qa:numbering": "node qa/curriculum-plan.cjs",
    "access:build": "node scripts/build-batch-access.cjs",
    "qa:routes": "node qa/session-routes-server.mjs && node qa/offline-routes.cjs routes",
    "qa:cohesion:offline": "node qa/offline-routes.cjs cohesion",
    "qa:release:offline": "node qa/offline-routes.cjs release"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "playwright": "^1.55.0"
  }
}
